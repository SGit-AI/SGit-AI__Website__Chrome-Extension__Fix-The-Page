{
  "manifest_version": 3,
  "name": "Fix the Page",
  "version": "0.1.0",
  "description": "Fix the page you are on, only when you ask: starting with the tab's title. No network, no telemetry.",
  "homepage_url": "https://fix-the-page.chrome-extensions.sgit.ai/",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Fix the Page: set this tab's title", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Fix the Page: set this tab's title" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
